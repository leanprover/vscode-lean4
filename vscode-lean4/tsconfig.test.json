{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "out",
        "rootDir": ".",
        "module": "commonjs",
        "types": ["node", "mocha"],
        "skipLibCheck": true,
        "allowUnreachableCode": false,
        // `tsconfig.json` only type-checks. This config compiles the tests to `out/`.
        "noEmit": false
    },
    "include": ["test/**/*", "src/**/*"],
    "exclude": ["node_modules", "test/fixtures"]
}
