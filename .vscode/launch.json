// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": ["--extensionDevelopmentPath=${workspaceRoot}/vscode-lean4"],
            "stopOnEntry": false,
            "sourceMaps": true,
            "outFiles": ["${workspaceRoot}/*/dist/**/*.js"],
            "preLaunchTask": "watch",
            "debugWebviews": true,
            "rendererDebugOptions": {
                "webRoot": "${workspaceRoot}/vscode-lean4/media"
            }
        },
        {
            // Debug one file of `vscode-lean4/test/vscode-test-cli/`. Breakpoints
            // work in the test and in `vscode-lean4/src/`. When you add a test
            // file, add its name to `inputs` below (`test/unit/launchConfig.test.ts`
            // fails until you do).
            "name": "Debug vscode-test-cli (pick label)",
            "type": "extensionHost",
            "request": "launch",
            "testConfiguration": "${workspaceFolder}/vscode-lean4/.vscode-test.mjs",
            "testConfigurationLabel": "cli-${input:cliLabel}",
            "outFiles": ["${workspaceFolder}/vscode-lean4/out/**/*.js", "${workspaceFolder}/vscode-lean4/dist/**/*.js"],
            "preLaunchTask": "prepare-test-debug"
        },
        {
            // Debug the open vitest file. Vitest runs the tests in worker
            // processes; `autoAttachChildProcesses` attaches to them.
            "name": "Debug Vitest (current file)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": ["run", "${relativeFile}"],
            "autoAttachChildProcesses": true,
            "smartStep": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        },
        {
            // All tests except the network tests. Opens real VS Code windows.
            "name": "Run all non-network tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["test"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // The same in `xvfb-run` on Linux (see `vscode-lean4/scripts/headless.mjs`).
            "name": "Run all non-network tests (headless)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test:headless"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // The network tests: elan install, Mathlib. Slow, and downloads several GB.
            "name": "Run all network tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test:network", "--workspace=lean4"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            // The same in `xvfb-run` on Linux.
            "name": "Run all network tests (headless)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test:headless:network", "--workspace=lean4"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "inputs": [
        {
            "id": "cliLabel",
            "type": "pickString",
            "description": "vscode-test-cli label to debug",
            "options": [
                "abbreviation",
                "adhoc",
                "imports",
                "lakefile-toml-schema",
                "launch-modes",
                "multi-root",
                "preconditions",
                "project-actions",
                "project-init",
                "server-launch",
                "smoke",
                "version-management"
            ]
        }
    ]
}
