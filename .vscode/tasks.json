// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch",
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "owner": "typescript",
                "source": "ts",
                "fileLocation": "absolute",
                "applyTo": "closedDocuments",
                "pattern": [
                    {
                        "regexp": "\\[tsl\\] (ERROR|WARNING) in (.*)?\\((\\d+),(\\d+)\\)",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "column": 4
                    },
                    {
                        "regexp": "\\s*TS(\\d+):\\s*(.*)$",
                        "code": 1,
                        "message": 2
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^extension:",
                    "endsPattern": "webpack .* compiled .* in "
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": "build"
        },
        {
            "label": "build",
            "type": "npm",
            "script": "build:dev",
            "problemMatcher": {
                "owner": "typescript",
                "source": "ts",
                "fileLocation": "absolute",
                "applyTo": "closedDocuments",
                "pattern": [
                    {
                        "regexp": "\\[tsl\\] (ERROR|WARNING) in (.*)?\\((\\d+),(\\d+)\\)",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "column": 4
                    },
                    {
                        "regexp": "\\s*TS(\\d+):\\s*(.*)$",
                        "code": 1,
                        "message": 2
                    }
                ]
            },
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Compiles the tests to `vscode-lean4/out/`. Depends on `build`,
            // because the tests import types from the `dist/` folders.
            "label": "compile-tests",
            "type": "shell",
            "command": "npm run compile-tests --workspace=lean4",
            "problemMatcher": "$tsc",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "never"
            }
        },
        {
            // The `preLaunchTask` of the vscode-test-cli debug configuration.
            // Compiles the tests and prepares the test home: the debug
            // configuration starts VS Code without `scripts/runCliTests.mjs`.
            "label": "prepare-test-debug",
            "type": "shell",
            "command": "node vscode-lean4/scripts/prepareTestHome.mjs",
            "problemMatcher": [],
            "dependsOn": "compile-tests",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "never"
            }
        },
        {
            // All tests except the network tests, in `xvfb-run` on Linux.
            "label": "test",
            "type": "npm",
            "script": "test:headless",
            "dependsOn": "build",
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
